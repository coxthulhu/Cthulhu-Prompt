{
  "name": "cthulhuprompt",
  "productName": "Cthulhu Prompt",
  "version": "0.0.33",
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "better-sqlite3": false
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.0",
      "onFail": "error"
    }
  },
  "description": "Cthulhu Prompt",
  "main": "./out/main/index.js",
  "author": "coxthulhu",
  "homepage": "https://github.com/coxthulhu/Cthulhu-Prompt",
  "scripts": {
    "format": "prettier --plugin prettier-plugin-svelte --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.web.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json --composite false",
    "typecheck": "npm run typecheck:node && npm run svelte-check && npm run typecheck:tests",
    "dev": "cross-env DEV_ENVIRONMENT=DEV CHOKIDAR_USEPOLLING=1 CHOKIDAR_INTERVAL=200 electron-vite dev --watch",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "patch-package && electron-builder install-app-deps && node scripts/verify-sqlite.mjs",
    "test:vitest": "vitest run tests/vitest",
    "test:playwright": "py -3 .\\RunPlaywrightCompact.py"
  },
  "dependencies": {
    "@codingame/monaco-vscode-all-language-default-extensions": "^31.0.1",
    "@codingame/monaco-vscode-api": "^31.0.1",
    "@codingame/monaco-vscode-configuration-service-override": "^31.0.1",
    "@codingame/monaco-vscode-css-language-features-default-extension": "^31.0.1",
    "@codingame/monaco-vscode-html-language-features-default-extension": "^31.0.1",
    "@codingame/monaco-vscode-json-language-features-default-extension": "^31.0.1",
    "@codingame/monaco-vscode-languages-service-override": "^31.0.1",
    "@codingame/monaco-vscode-markdown-language-features-default-extension": "^31.0.1",
    "@codingame/monaco-vscode-model-service-override": "^31.0.1",
    "@codingame/monaco-vscode-textmate-service-override": "^31.0.1",
    "@codingame/monaco-vscode-theme-defaults-default-extension": "^31.0.1",
    "@codingame/monaco-vscode-theme-service-override": "^31.0.1",
    "@codingame/monaco-vscode-typescript-language-features-default-extension": "^31.0.1",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/svelte-db": "^0.3.8",
    "better-sqlite3": "13.0.3",
    "gray-matter": "^4.0.3",
    "immer": "^11.1.4",
    "lucide-svelte": "^1.0.1",
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@^31.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.11",
    "tokenx": "^1.3.0",
    "vscode": "npm:@codingame/monaco-vscode-extension-api@^31.0.1"
  },
  "devDependencies": {
    "@codingame/esbuild-import-meta-url-plugin": "^1.0.3",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.41.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^22.16.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-svelte": "^3.13.0",
    "memfs": "^4.6.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.53.0",
    "svelte-check": "^4.4.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^7.0.5",
    "vitest": "^4.1.5"
  }
}
