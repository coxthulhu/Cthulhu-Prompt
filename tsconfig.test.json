{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "tests/**/*",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/shared/**/*",
    "src/preload/*.d.ts",
    "src/renderer/src/vite-env.d.ts",
    "src/renderer/src/features/prompt-editor/MonacoEditorRegistry.ts"
  ],
  "exclude": [
    "tests/legacy/**"
  ],
  "compilerOptions": {
    "composite": true,
    "allowImportingTsExtensions": true,
    "types": ["vitest/globals", "@playwright/test", "node"],
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  }
}
